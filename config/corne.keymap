#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            display-name = "Base";
            bindings = <
&kp TAB                    &kp Q  &kp W  &kp F     &kp P  &kp G        &kp J      &kp L  &kp U         &kp Y    &kp SEMICOLON  &kp BSPC
&mt LEFT_CONTROL CAPSLOCK  &kp A  &kp R  &kp S     &kp T  &kp D        &kp H      &kp N  &kp E         &kp I    &kp O          &mt RIGHT_CONTROL SQT
&kp LSHFT                  &kp Z  &kp X  &kp C     &kp V  &kp B        &kp K      &kp M  &kp COMMA     &kp DOT  &kp FSLH       &kp RIGHT_SHIFT
                                         &kp LGUI  &mo 1  &kp ENTER    &kp SPACE  &mo 2  &kp LEFT_ALT
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Lower";
            bindings = <
&kp ESCAPE  &kp EXCLAMATION  &kp AT_SIGN  &kp HASH          &kp DOLLAR      &kp PERCENT      &kp CARET  &kp AMPERSAND    &kp ASTERISK       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp DELETE
&kp GRAVE   &kp UNDERSCORE   &kp PLUS     &kp LEFT_BRACKET  &kp LEFT_BRACE  &kp BACKSLASH    &kp PIPE   &kp RIGHT_BRACE  &kp RIGHT_BRACKET  &kp EQUAL             &kp MINUS              &kp TILDE
&trans      &trans           &trans       &trans            &trans          &trans           &trans     &trans           &trans             &trans                &trans                 &trans
                                          &trans            &trans          &trans           &trans     &mo 3            &trans
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Raise";
            bindings = <
&trans  &trans  &kp K_MUTE      &kp C_VOLUME_UP    &kp C_BRIGHTNESS_INC  &trans    &trans  &kp HOME        &kp UP_ARROW    &kp END          &kp PAGE_UP    &trans
&trans  &trans  &kp C_PREVIOUS  &kp K_PLAY_PAUSE   &kp C_NEXT            &trans    &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp PAGE_DOWN  &trans
&trans  &trans  &kp C_STOP      &kp C_VOLUME_DOWN  &kp C_BRIGHTNESS_DEC  &trans    &trans  &trans          &trans          &trans           &trans         &trans
                                &kp LEFT_ALT       &mo 4                 &trans    &trans  &trans          &trans
            >;
        };

        num_layer {
            display-name = "Raise";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp DOT       &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans        &trans
                        &trans  &trans  &trans    &trans  &trans        &trans
            >;
        };

        func_layer {
            display-name = "Raise";
            bindings = <
&trans      &trans        &trans        &trans          &trans            &trans          &trans  &kp F7  &kp F8  &kp F9  &kp F12  &trans
&trans      &trans        &kp LEFT_ALT  &kp LEFT_SHIFT  &kp LEFT_CONTROL  &trans          &trans  &kp F4  &kp F5  &kp F6  &kp F11  &trans
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2    &bt BT_SEL 3      &bt BT_SEL 4    &trans  &kp F1  &kp F2  &kp F3  &kp F10  &trans
                                        &trans          &trans            &trans          &trans  &trans  &trans
            >;
        };
    };
};
